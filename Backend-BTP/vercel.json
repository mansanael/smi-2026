{
  "version": 2,
  "builds": [
    {
      "src": "dist/vercel.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "dist/vercel.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/alertes",
      "schedule": "0 7 * * *"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
